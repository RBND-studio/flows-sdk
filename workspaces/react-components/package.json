{
  "name": "@flows/react-components",
  "version": "2.9.6",
  "description": "Built-in components for Flows React SDK",
  "keywords": [
    "react",
    "ux",
    "guide",
    "spotlight",
    "popover",
    "overlay",
    "users",
    "saas",
    "onboarding",
    "tour",
    "walkthrough",
    "user-onboarding",
    "feature-introductions",
    "onboarding-tool",
    "product-adoption",
    "product-tours"
  ],
  "scripts": {
    "dev": "tsup --env.NODE_ENV development",
    "build": "tsup --env.NODE_ENV production",
    "tsc": "tsc -p tsconfig.json",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "prepare": "pnpm build"
  },
  "license": "MIT",
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RBND-studio/flows-sdk.git"
  },
  "homepage": "https://flows.sh",
  "devDependencies": {
    "@flows/shared": "workspace:*",
    "@flows/styles": "workspace:*",
    "@types/node": "^24.12.0",
    "@types/react": "^19.3.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitest/coverage-v8": "^5.1.0",
    "jsdom": "^30.1.3",
    "tsup": "^9.0.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "@floating-ui/react-dom": "^2.1.9",
    "clsx": "^2.1.1",
    "dompurify": "^3.4.17",
    "es-toolkit": "^1.52.0"
  },
  "peerDependencies": {
    "@flows/react": ">=1.18.0",
    "react": ">=17.0.2"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./tour": {
      "types": "./dist/tour.d.ts",
      "import": "./dist/tour.mjs",
      "require": "./dist/tour.js"
    },
    "./survey": {
      "types": "./dist/survey.d.ts",
      "import": "./dist/survey.mjs",
      "require": "./dist/survey.js"
    },
    "./index.css": {
      "import": "./dist/index.css",
      "require": "./dist/index.css"
    }
  }
}
